#DB settings
DB_HOST=localhost
DB_USER_NAME=test
DB_PASSWORD=test1234
DB_NAME=test_db
DB_PORT=5432

DB_URL=postgresql+psycopg2://{DB_USER_NAME}:{DB_PASSWORD}@{DB_HOST}:{DB_PORT}/{DB_NAME}

# Project Settings
PROJECT_NAME=ESTIM
APP_NAME=ESTIM
ENVIRONMENT=development

# AI & Processing Engine
AI_DEVICE=auto
FRAME_SAMPLE_RATE=2.0
DETECTION_CONFIDENCE_THRESHOLD=0.50
INCIDENT_COOLDOWN_SECONDS=60
TEMPORAL_CONFIRMATION_FRAMES=3
TRACK_MISS_TTL=8
SNAPSHOTS_DIR=uploads/snapshots
PERSON_MODEL_PATH=yolov8n.pt
PPE_MODEL_PATH=
FIRE_SMOKE_MODEL_PATH=
POSE_MODEL_PATH=
ENABLE_PPE_MODEL=false
ENABLE_FIRE_SMOKE_MODEL=false
ENABLE_POSE_FALL_MODEL=false
ENABLE_RTSP_WORKERS=true
AI_MAX_WORKERS=2
AI_FRAME_QUEUE_SIZE=2
PPE_CADENCE=2
FIRE_SMOKE_CADENCE=4
POSE_CADENCE=3
